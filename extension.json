{
	"name": "Hide Metadata Section",
	"version": "0.3.0",
	"update": "2026-02-02",
	"author": "Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])",
	"url": "https://github.com/kolzchut/mediawiki-extensions-HideMetadataSection",
	"descriptionmsg": "hidemetadatasection-desc",
	"license-name": "GPL-2.0-or-later",
	"MessagesDirs": {
		"HideMetadataSection": [
			"i18n"
		]
	},
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\HideMetadataSection\\": "src/"
	},
	"HookHandlers": {
		"HideMetadataSection": {
			"class": "MediaWiki\\Extension\\HideMetadataSection\\Hooks"
		}
	},
	"Hooks": {
		"ParserBeforeInternalParse": "HideMetadataSection",
		"OutputPageParserOutput": "HideMetadataSection"
	},
	"manifest_version": 2
}
